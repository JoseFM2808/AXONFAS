# ── AXONFAS · STAGING (droplet 1× MI300X en AMD Developer Cloud) ──────────────────────
# Copiar a config/.env.staging (ignorado por git) y completar. Solo datos sintéticos (ADR-010).
# Nunca pongas aquí datos de pacientes. Las variables marcadas "secreto" no se comparten.
AXONFAS_ENV=staging

# Base de datos (PostgreSQL con pacientes ficticios). Secreto: la URL lleva la contraseña.
AXONFAS_DATABASE_URL=

# LLM servido con vLLM sobre ROCm (ADR-006). Modelo abierto de 7–8B, por elegir (TD-04).
AXONFAS_VLLM_BASE_URL=http://127.0.0.1:8000/v1
AXONFAS_LLM_MODEL=

# Voz y pose sobre ROCm (por elegir: TD-04 y TD-05)
AXONFAS_STT_MODEL=
AXONFAS_TTS_MODEL=
AXONFAS_POSE_LIFTER_MODEL=

# Bucle rápido de seguridad (ADR-004) y costo por sesión (02-architecture.md)
AXONFAS_ALERT_LATENCY_BUDGET_MS=250
AXONFAS_GPU_PRICE_USD_PER_HOUR=1.99
