# ── AXONFAS · servidor web (Staging) en la nube de AMD o en tu PC (ADR-018/019/020) ─────────────────────────────
# Copia este archivo y complétalo SIN subirlo a git:
#   · en el droplet:   config/.env.web            (lo copia `axonfas-cloud.ps1 web-deploy`)
#   · en tu PC:        ~/.axonfas/axonfas.env      (lo lee serve.py; fuera del repo y de Drive)
# Solo datos sintéticos o del equipo con consentimiento (ADR-010). Las líneas "secreto" no se comparten ni se pegan en
# un chat.

# Dominio público con HTTPS (Caddy lo certifica solo). Sin dominio propio: <ip-con-guiones>.sslip.io
AXONFAS_DOMAIN=

# Inicio de sesión con Google (ID de cliente OAuth tipo «Aplicación web»; es público).
# Orígenes JavaScript autorizados en Google Cloud: https://<AXONFAS_DOMAIN>, la URL de Vercel y http://localhost:8091
GOOGLE_CLIENT_ID=

# Correos del Administrador maestro (el equipo), separados por comas. Nunca en el repo.
AXONFAS_ADMIN_EMAILS=

# IA: AMD Token Factory (https://notebooks.amd.com/tokenfactory). Única fuente de IA permitida en el hackathon.
# URL base (manual de Token Factory): https://developer.amd.com.cn/radeon/api/v1 · modelo sugerido: DeepSeek-V4-Flash
AMD_TOKENFACTORY_BASE_URL=
# secreto
AMD_TOKENFACTORY_API_KEY=
# un id del catálogo; vacío = el primero que devuelva /models
AMD_TOKENFACTORY_MODEL=

# Cuentas de demostración sin contraseña (1 = encendidas). En un despliegue público, 0: se entra solo con Google.
AXONFAS_DEMO_ACCOUNTS=1

# Si la web vive en otro dominio (Vercel), su origen exacto, por ejemplo https://axonfas.vercel.app
AXONFAS_CORS_ORIGINS=
