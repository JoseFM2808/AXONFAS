{
  "name": "axonfas-video-presentation",
  "version": "1.0.0",
  "private": true,
  "description": "AXONFAS presentation video generated with code (Remotion + local TTS). Run it through video.py.",
  "license": "UNLICENSED",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts AXONFAS out/axonfas.mp4 --codec=h264 --crf=18",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/google-fonts": "4.0.532",
    "@remotion/media": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "typescript": "5.9.2"
  }
}
